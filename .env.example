# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BLOB_READ_WRITE_TOKEN: (Optional for Vercel)
# Automatically provided by Vercel when connecting Vercel Blob (Vercel Dashboard > Storage > Blob).
# Enables permanent CDN uploads for videos/images and cloud persistence for project data.
BLOB_READ_WRITE_TOKEN=""

# ADMIN_JWT_SECRET: (Optional)
# Secret key used to cryptographically sign admin bearer session tokens.
# Defaults to an internal key if not provided.
ADMIN_JWT_SECRET=""

# ADMIN_USERNAME & ADMIN_PASSWORD_HASH: (Optional)
# Allows overriding the default admin username and SHA-256 hashed password.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""
